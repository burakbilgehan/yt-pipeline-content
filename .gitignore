# yt-pipeline content repo
# Only text-based files are tracked. All media/binary files are excluded.

# Video renders & output
*.mp4
*.mkv
*.avi
*.mov
*.webm

# Audio (only BGM excluded — TTS wav tracked for cross-machine sync)
*.mp3
*.ogg
*.flac
*.aac

# Images & visuals
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.bmp
*.tiff

# EXCEPT brand assets — these are small and important
!channel-assets/logo.png
!channel-assets/banner.png
!channel-assets/watermark.png

# Test renders directory (all contents)
**/test-renders/

# Production output directory
**/production/output/

# Collected visuals (stock media, AI images)
**/production/visuals/

# BGM subdirectory (large music files)
**/production/audio/bgm/
# Audio archive
**/production/audio/_archive/

# Cache
**/cache/

# OS files
.DS_Store
Thumbs.db
